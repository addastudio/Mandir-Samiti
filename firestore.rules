
/**
 * @file Firestore Security Rules for Mandir Samiti Bahpura Web Application
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId}/donations/{donationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /gallery/{galleryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /notices/{noticeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /prayer_requests/{requestId} {
      allow create: if true;
      // Users can read their own prayer requests. Admins can read all.
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /roles_admin/{userId} {
      // Allow any logged-in user to check if they (or others) are admin for UI purposes
      allow get: if request.auth != null;
      // Listing admins and managing roles is strictly for existing admins
      allow list: if isAdmin();
      // Only existing admins can create/grant new admin roles
      allow create: if isAdmin();
      // Admins can remove roles, and users can remove their own (Resign)
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      // Roles are managed by deletion and creation, no direct updates
      allow update: if false;
    }
  }
}
