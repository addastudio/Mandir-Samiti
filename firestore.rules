/**
 * @file Firestore Security Rules for Mandir Samiti Bahpura Web Application
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the request is from a designated administrator
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // User Profile Rules
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      
      // Allow reading profile if it's yours or if you are an admin
      allow get: if isOwner(userId) || isAdmin();
      
      // Listing all users is restricted to admins for management purposes
      allow list: if isAdmin();
      
      // Users can create their own profile upon signup
      allow create: if isOwner(userId);
      
      // Users can update their own info (language, phone, etc). Admins can update roles.
      allow update: if isOwner(userId) || isAdmin();
      
      // Critical: Allow users to delete their own record (e.g., account deletion)
      // and allow admins to purge records.
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Donation Records
    match /users/{userId}/donations/{donationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      // Donations are permanent records, usually only deletable by high-level admins if at all
      allow update, delete: if isAdmin();
    }

    // Events (Publicly Readable, Admin Managed)
    match /events/{eventId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Gallery (Publicly Readable, Admin Managed)
    match /gallery/{galleryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Notices (Publicly Readable, Admin Managed)
    match /notices/{noticeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Prayer Requests
    match /prayer_requests/{requestId} {
      // Anyone can submit a request (devotees might not be logged in)
      allow create: if true;
      // Users read their own. Admins read all.
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Admin Roles Management
    match /roles_admin/{userId} {
      // Allow any logged-in user to check if they are an admin for UI routing
      allow get: if request.auth != null;
      
      // Only existing admins can see the full list of other admins
      allow list: if isAdmin();
      
      // Only existing admins can grant new admin privileges
      allow create: if isAdmin();
      
      // Users can resign (delete their own role) or admins can remove others
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      
      // Role metadata shouldn't be updated directly, only added/removed
      allow update: if false;
    }
  }
}
