
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the Mandir Samiti Bahpura web application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user entity."
        },
        "name": {
          "type": "string",
          "description": "User's full name."
        },
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "User's phone number."
        },
        "address": {
          "type": "string",
          "description": "User's physical address."
        },
        "role": {
          "type": "string",
          "description": "User's role within the application (e.g., 'user', 'admin')."
        },
        "language": {
          "type": "string",
          "description": "User's preferred language (e.g., 'hi-IN', 'en-US')."
        },
        "twoFactorEnabled": {
          "type": "boolean",
          "description": "Whether 2-step verification is enabled."
        },
        "twoFactorPin": {
          "type": "string",
          "description": "6-digit PIN for 2-step verification."
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "role",
        "language"
      ]
    },
    "Donation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Donation",
      "type": "object",
      "description": "Represents a donation made to the Mandir Samiti Bahpura.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the donation entity."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Donation)"
        },
        "amount": {
          "type": "number",
          "description": "Amount of the donation."
        },
        "date": {
          "type": "string",
          "description": "Date and time when the donation was made.",
          "format": "date-time"
        },
        "mode": {
          "type": "string",
          "description": "Method used for the donation (e.g., 'UPI', 'QR code', 'Bank Transfer')."
        }
      },
      "required": [
        "id",
        "userId",
        "amount",
        "date",
        "mode"
      ]
    },
    "Event": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Event",
      "type": "object",
      "description": "Represents an event organized by the Mandir Samiti Bahpura.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the event entity."
        },
        "title": {
          "type": "string",
          "description": "Title of the event."
        },
        "date": {
          "type": "string",
          "description": "Date and time of the event.",
          "format": "date-time"
        },
        "description": {
          "type": "string",
          "description": "Description of the event."
        },
        "image": {
          "type": "string",
          "description": "URL or path to the event's image."
        }
      },
      "required": [
        "id",
        "title",
        "date",
        "description"
      ]
    },
    "Gallery": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Gallery",
      "type": "object",
      "description": "Represents an image in the temple gallery.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the gallery item."
        },
        "imageURL": {
          "type": "string",
          "description": "URL of the image."
        },
        "caption": {
          "type": "string",
          "description": "Caption or description of the image."
        },
        "uploadedBy": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Gallery)"
        }
      },
      "required": [
        "id",
        "imageURL"
      ]
    },
    "Notice": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Notice",
      "type": "object",
      "description": "Represents a public notice or announcement from the temple committee.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the notice."
        },
        "title": {
          "type": "string",
          "description": "The headline of the notice."
        },
        "content": {
          "type": "string",
          "description": "The detailed message."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of creation.",
          "format": "date-time"
        },
        "importance": {
          "type": "string",
          "enum": ["normal", "urgent"],
          "description": "Priority level of the notice."
        }
      },
      "required": ["id", "title", "content", "createdAt"]
    },
    "PrayerRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PrayerRequest",
      "type": "object",
      "description": "Represents a prayer or ritual request submitted by a devotee.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "requestType": { "type": "string", "enum": ["prayer", "puja", "other"] },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "viewed", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string", "description": "Optional reference to a registered User." }
      },
      "required": ["id", "name", "requestType", "message", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profile information.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/donations/{donationId}",
        "definition": {
          "entityName": "Donation",
          "schema": {
            "$ref": "#/backend/entities/Donation"
          },
          "description": "Stores donation records for each user.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user."
            },
            {
              "name": "donationId",
              "description": "The unique identifier for the donation."
            }
          ]
        }
      },
      {
        "path": "/events/{eventId}",
        "definition": {
          "entityName": "Event",
          "schema": {
            "$ref": "#/backend/entities/Event"
          },
          "description": "Stores event information.",
          "params": [
            {
              "name": "eventId",
              "description": "The unique identifier for the event."
            }
          ]
        }
      },
      {
        "path": "/gallery/{galleryId}",
        "definition": {
          "entityName": "Gallery",
          "schema": {
            "$ref": "#/backend/entities/Gallery"
          },
          "description": "Stores gallery images.",
          "params": [
            {
              "name": "galleryId",
              "description": "The unique identifier for the gallery item."
            }
          ]
        }
      },
      {
        "path": "/notices/{noticeId}",
        "definition": {
          "entityName": "Notice",
          "schema": {
            "$ref": "#/backend/entities/Notice"
          },
          "description": "Stores temple announcements and notices.",
          "params": [
            {
              "name": "noticeId",
              "description": "The unique identifier for the notice."
            }
          ]
        }
      },
      {
        "path": "/prayer_requests/{requestId}",
        "definition": {
          "entityName": "PrayerRequest",
          "schema": {
            "$ref": "#/backend/entities/PrayerRequest"
          },
          "description": "Stores prayer and ritual requests from devotees.",
          "params": [
            {
              "name": "requestId",
              "description": "Unique identifier for the request."
            }
          ]
        }
      },
      {
        "path": "/roles_admin/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "type": "object",
            "properties": {
              "assignedAt": { "type": "string" }
            }
          },
          "description": "Collection used to grant admin privileges. A document here with a user's UID as the ID grants admin rights.",
          "params": [
            {
              "name": "userId",
              "description": "The UID of the user."
            }
          ]
        }
      }
    ],
    "reasoning": "Standard structure with admin roles and public content managed by admins."
  }
}
