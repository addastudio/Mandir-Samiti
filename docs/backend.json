{
  "entities": {
    "AdminActivityLog": {
      "title": "AdminActivityLog",
      "description": "History of administrative actions performed by users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminId": { "type": "string" },
        "adminName": { "type": "string" },
        "actionType": { "type": "string", "enum": ["CREATE", "DELETE", "UPDATE", "GRANT_ADMIN", "REMOVE_ADMIN", "UPDATE_ROLE", "RESIGN"] },
        "entityType": { "type": "string" },
        "entityTitle": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["adminId", "actionType", "entityType", "timestamp"]
    },
    "User": {
      "title": "User",
      "description": "User profile data.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "isVerified": { "type": "boolean" }
      }
    },
    "Donation": {
      "title": "Donation",
      "description": "Donation record.",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "mode": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "SevaProgram": {
      "title": "SevaProgram",
      "description": "A community service program.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string", "enum": ["UtensilsCrossed", "HeartHandshake", "BookOpenCheck", "Users", "Hand", "Shield"] }
      },
      "required": ["title", "description", "icon"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Devotee feedback.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "quote": { "type": "string" },
        "imageURL": { "type": "string" }
      },
      "required": ["name", "quote"]
    },
    "WebsiteSettings": {
      "title": "WebsiteSettings",
      "description": "Global website configuration.",
      "type": "object",
      "properties": {
        "liveAartiUrl": { "type": "string", "description": "YouTube URL for Live Darshan." }
      }
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/admin_activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminActivityLog" },
      "description": "Audit trail of administrative actions."
    },
    "/events/{eventId}": { "description": "Public events." },
    "/gallery/{galleryId}": { "description": "Temple media gallery." },
    "/notices/{noticeId}": { "description": "Temple announcements." },
    "/prayer_requests/{requestId}": { "description": "Devotee prayer and ritual requests." },
    "/roles_admin/{adminId}": { "description": "Registry of administrative UIDs." },
    "/seva_programs/{programId}": {
      "schema": { "$ref": "#/entities/SevaProgram" },
      "description": "Dynamic community service programs."
    },
    "/testimonials/{testimonialId}": {
      "schema": { "$ref": "#/entities/Testimonial" },
      "description": "Devotee testimonials."
    },
    "/settings/website": { 
      "schema": { "$ref": "#/entities/WebsiteSettings" },
      "description": "Global website configuration (e.g. Live Aarti URL)." 
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles."
    },
    "/users/{userId}/donations/{donationId}": {
      "schema": { "$ref": "#/entities/Donation" },
      "description": "User donation history."
    }
  }
}